# Copy to .env (never commit .env). See docs/ for details.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://subcycle:subcycle@localhost:5434/subcycle
# Comma-separated allowlist of browser origins (required in production; no wildcards).
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used in email links). Must be https in production.
APP_URL=http://localhost:5173
# Set to a hop count (e.g. 1) when behind a reverse proxy so client IPs are correct for rate limiting.
TRUST_PROXY=false
LOG_LEVEL=info

# Optional SMTP. If SMTP_HOST/SMTP_PORT/SMTP_FROM are all unset, email is DISABLED:
# email reminders and email verification are reported as unavailable, never as "sent".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SubCycle <no-reply@example.com>"

# Used only by the test suite.
# TEST_DATABASE_URL=postgres://subcycle:subcycle@localhost:5434/subcycle_test
